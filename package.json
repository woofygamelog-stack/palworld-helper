{
  "name": "palworld-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/generate-static.mjs && node scripts/check-built.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run.mjs",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs",
    "data:import:pals": "node scripts/import-pal-data.mjs",
    "data:import:items": "node scripts/import-item-data.mjs",
    "check": "npm run typecheck && npm run check:i18n && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
