{
  "name": "palworld-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:npcs": "node scripts/import-npcs.mjs && node scripts/import-world-map-points.mjs",
    "data:import:dungeons": "node scripts/import-dungeon-data.mjs && node scripts/import-world-map-points.mjs",
    "dev": "vite",
    "build": "node scripts/generate-map-tiles.mjs && vite build && node --experimental-strip-types scripts/generate-static.mjs && node --experimental-strip-types scripts/check-built.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run.mjs && node scripts/validate-map-data.mjs && node scripts/validate-npc-data.mjs && node scripts/validate-dungeon-data.mjs && node scripts/validate-expedition-data.mjs",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs",
    "check:item-images": "node scripts/check-item-images.mjs",
    "data:import:pals": "node scripts/import-pal-data.mjs",
    "data:import:items": "node scripts/import-item-data.mjs",
    "data:import:map": "node scripts/import-map-data.mjs",
    "data:import:map-points": "node scripts/import-world-map-points.mjs",
    "data:import:images": "node scripts/import-images.mjs",
    "data:complete:item-images": "node scripts/complete-item-images.mjs",
    "data:import:skills": "node scripts/import-skill-data.mjs",
    "data:import:technology": "node scripts/import-technology-data.mjs",
    "data:import:structures": "node scripts/import-structure-data.mjs",
    "data:import:expeditions": "node scripts/import-expedition-data.mjs",
    "data:import:health": "node scripts/import-health-data.mjs",
    "data:import:elements": "node scripts/import-element-data.mjs",
    "data:verify:element-damage-source": "node scripts/verify-element-damage-source.mjs",
    "data:plan:element-damage-runtime": "node scripts/generate-element-damage-test-plan.mjs",
    "data:verify:element-damage-runtime": "node scripts/validate-element-damage-runtime.mjs",
    "check": "npm run typecheck && npm run check:i18n && npm run check:item-images && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
